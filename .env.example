DATABASE_URL=postgresql://user:pass@db:5432/ranklab
DATA_DIR=./data/processed
# Path to extracted EB-NeRD small folder (train/ + validation/ + articles.parquet).
EBNERD_RAW_PATH=./data/raw/ebnerd_small
MODEL_DIR=./models/checkpoints
API_HOST=0.0.0.0
API_PORT=8000

# Dataset: "small" downloads the EB-NeRD small subset (requires accepting the
# license at https://recsys.eb.dk/). "demo" generates a realistic synthetic
# dataset with the same schema so the full stack runs offline.
EBNERD_VARIANT=demo

# Training
EPOCHS=50
EMBEDDING_DIM=64
DEVICE=cpu
